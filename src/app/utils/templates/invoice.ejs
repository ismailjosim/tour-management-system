<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Booking Invoice</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            color: #333333;
            line-height: 1.6;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }
        .header {
            background-color: #029E9D;
            color: #ffffff;
            padding: 25px 20px;
            text-align: center;
        }
        .header img {
            height: 48px;
            width: auto;
            display: block;
            margin: 0 auto 8px;
        }
        .header p {
            margin: 0;
            font-size: 15px;
            opacity: 0.9;
        }
        .content {
            padding: 30px;
        }
        .details-table {
            width: 100%;
            margin-bottom: 30px;
        }
        .details-table td {
            vertical-align: top;
            width: 50%;
        }
        .details-title {
            font-size: 12px;
            text-transform: uppercase;
            color: #888888;
            margin: 0 0 5px 0;
            font-weight: bold;
        }
        .details-value {
            margin: 0 0 15px 0;
            font-size: 14px;
            font-weight: 500;
        }
        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        .invoice-table th {
            background-color: #f9f9f9;
            color: #555555;
            text-align: left;
            padding: 12px 15px;
            font-size: 13px;
            font-weight: 600;
            border-bottom: 2px solid #eeeeee;
        }
        .invoice-table td {
            padding: 15px;
            font-size: 14px;
            border-bottom: 1px solid #eeeeee;
        }
        .text-right {
            text-align: right !important;
        }
        .total-row td {
            font-weight: bold;
            font-size: 16px;
            color: #029E9D;
            border-bottom: none;
            padding-top: 20px;
        }
        .action-button {
            display: block;
            width: 250px;
            margin: 30px auto 0;
            background-color: #FDC703;
            color: #263A49;
            text-align: center;
            padding: 15px 20px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 16px;
        }
        .footer {
            background-color: #f9f9f9;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #888888;
            border-top: 1px solid #eeeeee;
        }
        .footer a {
            color: #029E9D;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <img src="https://traveler.ismailjosim.com/site-logo-light.png" alt="Traveler Logo" />
            <p>Your Booking is Confirmed!</p>
        </div>

        <!-- Content -->
        <div class="content">
            <table class="details-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <p class="details-title">Invoice Date</p>
                        <p class="details-value"><%= new Date(bookingDate).toLocaleDateString() %></p>
                        
                        <p class="details-title">Transaction ID</p>
                        <p class="details-value"><%= transactionId %></p>
                    </td>
                    <td class="text-right">
                        <p class="details-title">Billed To</p>
                        <p class="details-value"><%= userName %><br><%= userEmail %></p>
                    </td>
                </tr>
            </table>

            <table class="invoice-table" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%= tourTitle %></td>
                        <td class="text-right"><%= totalAmount %></td>
                    </tr>
                    <tr class="total-row">
                        <td class="text-right">Total Amount Due</td>
                        <td class="text-right"><%= totalAmount %></td>
                    </tr>
                </tbody>
            </table>

            <a href="https://traveler.ismailjosim.com/profile/my-bookings" class="action-button">View Booking Details</a>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>If you have any questions regarding this invoice, please contact us at <a href="mailto:support@traveler.ismailjosim.com">support@traveler.ismailjosim.com</a></p>
            <p>&copy; <%= new Date().getFullYear() %> Traveler. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
